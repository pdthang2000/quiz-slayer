#!/bin/sh
# Runs before every `git commit`. Installed by `pnpm install` (root "prepare": core.hooksPath=.githooks).
# 1. Mechanical checks for the staged part of the repo: lint, tsc, unit tests, rules:coverage.
#    They run on the working tree, so unstaged edits count too.
#    Integration tests run only when the database, events or the outbox are staged (needs_int below).
# 2. DDD review gate: warns when staged code was not reviewed with /ddd-review.
#    To block instead of warn: git config quizslayer.strictDddReview true
# Skip everything once (emergencies only): git commit --no-verify
set -e
cd "$(git rev-parse --show-toplevel)"

staged=$(git diff --cached --name-only)
[ -n "$staged" ] || exit 0

if ! command -v pnpm >/dev/null 2>&1; then
  echo 'pre-commit: pnpm not found. Install pnpm, or commit with --no-verify if you really must.' >&2
  exit 1
fi

step() { printf '\n▶ %s\n' "$1"; }
touches() { printf '%s\n' "$staged" | grep -qE "$1"; }

# Keep this default in step with apps/api/test/int/test-database.ts.
int_db_reachable() {
  node -e '
    const url = new URL(process.env.DATABASE_URL_TEST || "postgresql://localhost:5432");
    const socket = require("node:net").connect(Number(url.port) || 5432, url.hostname);
    socket.setTimeout(2000);
    socket.on("connect", () => process.exit(0));
    socket.on("timeout", () => process.exit(1));
    socket.on("error", () => process.exit(1));
  '
}

needs_int=false
if touches '^apps/api/(prisma/|src/prisma/|src/events/|src/(.*/)?infrastructure/|src/.*/domain/events\.ts$|src/shared/application/(outbox|event-publisher)\.ts$)'; then
  needs_int=true
  if ! int_db_reachable; then
    echo 'pre-commit: Postgres is not reachable, and the staged files need the integration tests. Start it with: docker compose up -d' >&2
    exit 1
  fi
fi

if touches '^apps/api/'; then
  step 'api: lint';       pnpm --filter @quizslayer/api lint
  step 'api: tsc';        pnpm --filter @quizslayer/api exec tsc --noEmit
  step 'api: unit tests'; pnpm --filter @quizslayer/api test --silent
fi

if [ "$needs_int" = true ]; then
  step 'api: integration tests'; pnpm --filter @quizslayer/api test:int
fi

if touches '^apps/mobile/'; then
  step 'mobile: lint';      pnpm --filter @quizslayer/mobile lint
  step 'mobile: typecheck'; pnpm --filter @quizslayer/mobile typecheck
  step 'mobile: tests';     pnpm --filter @quizslayer/mobile test --silent
fi

if touches '^(apps/|docs/domain/contexts/)'; then
  step 'rules:coverage'   # fails only on a rule ID that is in no context doc
  pnpm -s rules:coverage
fi

step 'DDD review'
if ! node .claude/hooks/ddd-review-gate.mjs --check; then
  if [ "$(git config --bool quizslayer.strictDddReview)" = 'true' ]; then
    exit 1
  fi
  echo '  (warning only, the commit continues)'
fi
