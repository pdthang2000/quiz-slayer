// Prisma schema for QuizSlayer.
// Prisma types never leave infrastructure/ (see CLAUDE.md). Business rules live in the domain;
// constraints here are backstops only.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------- Card Library ----------

enum CardState {
  Active
  Trashed

  @@map("card_state")
}

model Card {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  front     String
  back      String
  state     CardState
  /// TRASH-12: set by move to trash, cleared by restore.
  trashedAt DateTime? @map("trashed_at")
  /// CARD-08: optimistic locking. Inserts start at 0; every save bumps it.
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  tags      CardTag[]

  /// Target of card_tag's (card_id, user_id) foreign key (CARD-04, C-22).
  @@unique([id, userId])
  @@index([userId, state])
  /// READ-02, CARDTAG-08: Active cards newest first.
  @@index([userId, state, createdAt])
  @@map("card")
}

model Tag {
  id        String    @id @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  /// TAG-01 normalized. DB guard: CHECK (name IS NFC NORMALIZED), added in the migration (ADR-003).
  name      String
  /// TAG-13 palette key, validated by TagColor.
  color     String
  /// TAG-16: optimistic locking. Inserts start at 0; every tag change bumps it.
  version   Int       @default(0)
  createdAt DateTime  @default(now()) @map("created_at")
  cards     CardTag[]

  /// TAG-03
  @@unique([userId, name])
  /// Target of card_tag's (tag_id, user_id) foreign key (CARD-04, C-22).
  @@unique([id, userId])
  @@map("tag")
}

/// CardTag: owned by the Card. Cascades: delete card (TRASH-05), delete tag (TAG-06, TRASH-06).
/// user_id is in both foreign keys, so a card can only carry its owner's tags (CARD-04, C-22).
model CardTag {
  cardId String @map("card_id") @db.Uuid
  tagId  String @map("tag_id") @db.Uuid
  userId String @map("user_id") @db.Uuid
  card   Card   @relation(fields: [cardId, userId], references: [id, userId], onDelete: Cascade, map: "card_tag_card_fkey")
  tag    Tag    @relation(fields: [tagId, userId], references: [id, userId], onDelete: Cascade, map: "card_tag_tag_fkey")

  @@id([cardId, tagId])
  @@index([tagId])
  @@map("card_tag")
}

// ---------- Question Bank ----------

enum QuizSetVisibility {
  Private
  Public

  @@map("quiz_set_visibility")
}

/// QB-06: how the app shows a quiz.
enum QuizKind {
  single
  singleAudio  @map("single_audio")
  readingGroup @map("reading_group")
  audioGroup   @map("audio_group")

  @@map("quiz_kind")
}

/// One uploaded test (Quiz Set). owner_user_id NULL = System content (QB-10, B-21).
model QuizSet {
  id          String            @id @db.Uuid
  ownerUserId String?           @map("owner_user_id") @db.Uuid
  name        String
  /// QB-01, QB-02: per Quiz Set, Private by default.
  visibility  QuizSetVisibility @default(Private)
  createdAt   DateTime          @default(now()) @map("created_at")
  quizzes     Quiz[]

  @@index([ownerUserId])
  @@map("quiz_set")
}

/// A quiz: a single question, or a group (passage or audio + 2–4 questions) (QB-06, DP-17).
model Quiz {
  id         String     @id @db.Uuid
  quizSetId  String     @map("quiz_set_id") @db.Uuid
  /// The id in the imported file (e.g. "hsk4-s01"); re-importing keeps the quiz's id.
  externalId String     @map("external_id")
  kind       QuizKind
  passage    String?
  audioUrl   String?    @map("audio_url")
  position   Int
  quizSet    QuizSet    @relation(fields: [quizSetId], references: [id], onDelete: Cascade)
  questions  Question[]
  tags       QuizTag[]

  @@unique([quizSetId, externalId])
  @@map("quiz")
}

/// DP-07: multiple choice, 2–6 choices, one correct (the Answer Key).
model Question {
  id            String   @id @db.Uuid
  quizId        String   @map("quiz_id") @db.Uuid
  externalId    String   @map("external_id")
  position      Int
  text          String
  imageUrl      String?  @map("image_url")
  audioUrl      String?  @map("audio_url")
  choices       String[]
  correctChoice Int      @map("correct_choice")
  explanation   String?
  quiz          Quiz     @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@unique([quizId, externalId])
  @@map("question")
}

/// QB-07, QB-08: a question tag on a quiz (on the group, not its questions). A pool is every
/// quiz with a tag name (DP-11, QB-10). Names follow TAG-01; separate from Card tags.
model QuizTag {
  quizId String @map("quiz_id") @db.Uuid
  name   String
  quiz   Quiz   @relation(fields: [quizId], references: [id], onDelete: Cascade)

  @@id([quizId, name])
  @@index([name])
  @@map("quiz_tag")
}

// ---------- Daily Practice (ADR-013) ----------

enum TrackState {
  Active
  Removed

  @@map("track_state")
}

/// DP-09, DP-11, DP-12, DP-15. Unique per user and tag: re-adding reactivates the same row.
model Track {
  id        String         @id @db.Uuid
  userId    String         @map("user_id") @db.Uuid
  tagName   String         @map("tag_name")
  kinds     QuizKind[]
  dailySize Int            @map("daily_size")
  state     TrackState
  version   Int            @default(0)
  createdAt DateTime       @default(now()) @map("created_at")
  sessions  DailySession[]

  @@unique([userId, tagName])
  @@map("track")
}

/// DP-01: one per user, track and day. `quizzes` is the snapshot served (QB-04); quiz ids
/// point into the Question Bank without a foreign key (contexts don't share tables).
model DailySession {
  id          String    @id @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  trackId     String    @map("track_id") @db.Uuid
  /// DP-05: the day it was started, in the phone's timezone.
  day         DateTime  @db.Date
  timeZone    String    @map("time_zone")
  startedAt   DateTime  @map("started_at")
  tagName     String    @map("tag_name")
  dailySize   Int       @map("daily_size")
  /// DP-39: the served quiz ids, for "already in today's other sets".
  quizIds     String[]  @map("quiz_ids") @db.Uuid
  quizzes     Json
  answers     Json
  /// DP-32
  savedAsCard String[]  @map("saved_as_card")
  finishedAt  DateTime? @map("finished_at")
  version     Int       @default(0)
  track       Track     @relation(fields: [trackId], references: [id])

  @@unique([userId, trackId, day])
  @@index([userId, day])
  @@map("daily_session")
}

/// DP-27, DP-33, DP-37: one row per user and quiz once answered.
model QuizProgress {
  userId         String    @map("user_id") @db.Uuid
  quizId         String    @map("quiz_id") @db.Uuid
  lastAnsweredOn DateTime  @map("last_answered_on") @db.Date
  lastAnsweredAt DateTime  @map("last_answered_at")
  lastSessionId  String    @map("last_session_id") @db.Uuid
  /// DP-33: 1, 3 or 7; NULL = no mistake waiting.
  mistakeStage   Int?      @map("mistake_stage")
  mistakeDueOn   DateTime? @map("mistake_due_on") @db.Date
  version        Int       @default(0)

  @@id([userId, quizId])
  @@map("quiz_progress")
}

// ---------- Outbox (B-10) ----------

/// Domain events saved in the same transaction as the change that raised them, delivered
/// to their handlers after commit by the OutboxRelay. A crash between commit and delivery
/// loses nothing: undelivered rows are picked up again.
model OutboxEvent {
  id          String    @id @db.Uuid
  type        String
  payload     Json
  occurredAt  DateTime  @default(now()) @map("occurred_at")
  deliveredAt DateTime? @map("delivered_at")
  attempts    Int       @default(0)
  lastError   String?   @map("last_error")

  @@index([deliveredAt, occurredAt])
  @@map("outbox_event")
}
